<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit
        http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/db
        http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <configuration-properties file="config.yaml"/>

    <http:listener-config name="process-httpListener">
        <http:listener-connection host="0.0.0.0" port="${api.port}"/>
    </http:listener-config>

    <!--
      The Host-header workaround from the ENTSO-E module does NOT apply
      here: these calls go to localhost on non-default ports, where
      host:port in the Host header is correct.
    -->
    <http:request-config name="entsoe-sys-api">
        <http:request-connection host="${sys.entsoe.host}" port="${sys.entsoe.port}"/>
    </http:request-config>

    <http:request-config name="awattar-sys-api">
        <http:request-connection host="${sys.awattar.host}" port="${sys.awattar.port}"/>
    </http:request-config>

    <!--
      The store serves two purposes at once: the historical record, and
      the cache the flow falls back to when BOTH upstreams are
      unreachable. That fallback is what makes `source: CACHE` in the
      canonical model reachable at all.

      The password comes from config.yaml for local work and is
      overridden in a deployed instance with -Ddb.password=..., the same
      way the ENTSO-E token is supplied.
    -->
    <db:config name="priceStore">
        <db:generic-connection url="${db.url}"
                               driverClassName="org.postgresql.Driver"
                               user="${db.user}"
                               password="${db.password}">
            <!-- Pooling is a child element, not an attribute of the connection. -->
            <db:pooling-profile maxPoolSize="${db.poolMax}"/>
        </db:generic-connection>
    </db:config>

    <apikit:config name="process-config"
                   api="api/energy-process-api.raml"
                   outboundHeadersMapName="outboundHeaders"
                   httpStatusVarName="httpStatus"/>

    <!-- ============================================================
         Main flow
         ============================================================ -->

    <flow name="process-main">
        <http:listener config-ref="process-httpListener" path="/api/prc/energy/v1/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>

        <apikit:router config-ref="process-config"/>

        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <set-variable variableName="httpStatus" value="400"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <set-variable variableName="httpStatus" value="404"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <set-variable variableName="httpStatus" value="405"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>

            <on-error-propagate type="ENERGY:NO_DATA">
                <set-variable variableName="httpStatus" value="404"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>
            <on-error-propagate type="ENERGY:UPSTREAM_UNAVAILABLE">
                <set-variable variableName="httpStatus" value="502"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>

            <on-error-propagate type="MULE:TIMEOUT, HTTP:TIMEOUT">
                <set-variable variableName="httpStatus" value="504"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>
            <on-error-propagate type="ANY">
                <set-variable variableName="httpStatus" value="500"/>
                <flow-ref name="build-api-error"/>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- ============================================================
         APIkit routes here. Each flow stays thin.
         ============================================================ -->

    <flow name="get:\prices:process-config">
        <flow-ref name="collect-series"/>
        <set-payload value="#[%dw 2.0
            output application/json
            ---
            vars.series]"/>
    </flow>

    <flow name="get:\prices\current:process-config">
        <flow-ref name="collect-series"/>
        <set-payload value="#[%dw 2.0
            import currentPoint from modules::PriceLogic
            output application/java
            ---
            currentPoint(vars.series.points, now() >> 'UTC')]"/>

        <choice>
            <when expression="#[payload == null]">
                <raise-error type="ENERGY:NO_DATA"
                             description="No published interval covers the current instant."/>
            </when>
        </choice>

        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <flow name="get:\prices\cheapest-window:process-config">
        <set-variable variableName="hours"
                      value="#[(attributes.queryParams.hours default '4') as Number]"/>
        <set-variable variableName="notBefore"
                      value="#[if (attributes.queryParams.notBefore != null)
                                 (attributes.queryParams.notBefore as DateTime)
                               else null]"/>

        <flow-ref name="collect-series"/>

        <set-payload value="#[%dw 2.0
            import cheapestWindow from modules::PriceLogic
            output application/java
            ---
            cheapestWindow(vars.series.points, vars.hours, vars.notBefore)]"/>

        <choice>
            <when expression="#[payload == null]">
                <!--
                  Null means the series was shorter than the window, or
                  carried mixed resolutions. Either way the honest answer
                  is "no", not a window computed from part of the data.
                -->
                <raise-error type="ENERGY:NO_DATA"
                             description="Not enough published intervals for the requested window."/>
            </when>
        </choice>

        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <flow name="get:\health:process-config">
        <!--
          Liveness only. It does not call the upstreams on purpose: a
          health check that fans out to its dependencies turns one slow
          upstream into a failing health check.
        -->
        <set-payload value="#[%dw 2.0
            output application/json
            ---
            {
              status: 'UP',
              upstreams: [
                { name: 'ENTSOE',  role: 'PRIMARY',
                  endpoint: p('sys.entsoe.host') ++ ':' ++ p('sys.entsoe.port') },
                { name: 'AWATTAR', role: 'FALLBACK',
                  endpoint: p('sys.awattar.host') ++ ':' ++ p('sys.awattar.port') }
              ]
            }]"/>
    </flow>

    <!-- ============================================================
         Orchestration
         ============================================================ -->

    <sub-flow name="collect-series">
        <set-variable variableName="biddingZone"
                      value="#[attributes.queryParams.biddingZone default 'DE_LU']"/>

        <!--
          Default period is the current DELIVERY DAY IN BERLIN, not UTC.
          A delivery day is local: midnight-to-midnight Berlin is 22:00Z
          to 22:00Z in summer, so defaulting to UTC midnight would
          straddle two delivery days and return half of each.

          Built by formatting rather than coercing: `as Date as DateTime`
          is not a valid conversion and fails at runtime with
          "Cannot coerce Date to DateTime". The offset is taken from the
          current instant so it is correct on both sides of the DST
          changeover.
        -->
        <set-variable variableName="periodStart" value="#[%dw 2.0
            output application/java
            var berlinNow = now() >> 'Europe/Berlin'
            ---
            attributes.queryParams.periodStart default
                ((berlinNow as String {format: 'yyyy-MM-dd'}
                  ++ 'T00:00:00'
                  ++ (berlinNow as String {format: 'XXX'})) as DateTime)]"/>

        <set-variable variableName="periodEnd" value="#[%dw 2.0
            output application/java
            ---
            attributes.queryParams.periodEnd default
                ((vars.periodStart as DateTime) + |P1D|)]"/>

        <!--
          Both upstreams are asked in parallel, but they are NOT merged.
          ENTSO-E is authoritative at quarter-hourly resolution; aWATTar
          is hourly and answers only if ENTSO-E gave nothing. Interleaving
          them would either discard the 15-minute detail where negative
          price spikes live, or fabricate detail by claiming each quarter
          equals the hourly mean.

          aWATTar is still fetched even when ENTSO-E succeeds, because the
          agreement check below is the cheapest monitoring available: both
          publish the same auction, so they must agree.

          Each route carries its own try/on-error-continue. Without it,
          scatter-gather raises on any route failure and one flaky
          upstream takes down a request the other could have served.
        -->
        <scatter-gather timeout="${upstream.budgetMs}">
            <route>
                <try>
                    <flow-ref name="fetch-entsoe"/>
                    <error-handler>
                        <on-error-continue logException="true">
                            <logger level="WARN"
                                    message="#['ENTSOE route degraded corr='
                                              ++ (correlationId default '-')
                                              ++ ' err=' ++ (error.description default '-')]"/>
                            <set-payload value="#[[]]"/>
                        </on-error-continue>
                    </error-handler>
                </try>
            </route>
            <route>
                <try>
                    <flow-ref name="fetch-awattar"/>
                    <error-handler>
                        <on-error-continue logException="true">
                            <logger level="WARN"
                                    message="#['AWATTAR route degraded corr='
                                              ++ (correlationId default '-')
                                              ++ ' err=' ++ (error.description default '-')]"/>
                            <set-payload value="#[[]]"/>
                        </on-error-continue>
                    </error-handler>
                </try>
            </route>
        </scatter-gather>

        <set-variable variableName="entsoePoints" value="#[payload['0'].payload default []]"/>
        <set-variable variableName="awattarPoints" value="#[payload['1'].payload default []]"/>

        <!--
          Cross-source agreement. Both feeds publish the same EPEX
          auction, so every aWATTar hour must equal the mean of the four
          ENTSO-E quarters inside it. A divergence means one feed is
          stale or the wrong auction sequence is being selected - worth a
          WARN, not worth failing a request, because the primary series
          is still perfectly usable.
        -->
        <choice>
            <when expression="#[!isEmpty(vars.entsoePoints) and !isEmpty(vars.awattarPoints)]">
                <set-variable variableName="divergences" value="#[%dw 2.0
                    import crossCheck from modules::PriceLogic
                    output application/java
                    ---
                    crossCheck(vars.entsoePoints, vars.awattarPoints,
                               p('crosscheck.toleranceKWh') as Number)]"/>

                <choice>
                    <when expression="#[sizeOf(vars.divergences) > 0]">
                        <logger level="WARN"
                                message="#['Upstreams disagree on '
                                          ++ sizeOf(vars.divergences)
                                          ++ ' hour(s): '
                                          ++ write(vars.divergences, 'application/json')]"/>
                    </when>
                    <otherwise>
                        <logger level="INFO"
                                message="#['Cross-check OK: '
                                          ++ sizeOf(vars.awattarPoints)
                                          ++ ' hours agree with their quarter-hours']"/>
                    </otherwise>
                </choice>
            </when>
        </choice>

        <set-variable variableName="selected" value="#[%dw 2.0
            import selectSeries from modules::PriceLogic
            output application/java
            ---
            selectSeries(vars.entsoePoints, vars.awattarPoints)]"/>

        <!--
          Fresh data is stored; stale data is not re-stored. Writing back
          what we just read from the cache would refresh updated_at for
          no reason and make the audit trail lie about when a price was
          last confirmed.
        -->
        <choice>
            <when expression="#[!isEmpty(vars.selected.points)]">
                <set-variable variableName="toPersist" value="#[vars.entsoePoints ++ vars.awattarPoints]"/>
                <try>
                    <flow-ref name="persist-series"/>
                    <error-handler>
                        <!--
                          A failed write must not fail a read. The caller
                          asked for prices, and we have them.
                        -->
                        <on-error-continue logException="true">
                            <logger level="WARN"
                                    message="#['Persist failed, serving live data anyway: '
                                              ++ (error.description default '-')]"/>
                        </on-error-continue>
                    </error-handler>
                </try>
            </when>
            <otherwise>
                <!-- Both upstreams gave nothing: fall back to the store. -->
                <logger level="WARN"
                        message="#['Both upstreams empty, falling back to cache zone='
                                  ++ vars.biddingZone]"/>
                <try>
                    <flow-ref name="read-cached-series"/>
                    <set-variable variableName="selected"
                                  value="#[{ points: payload, degraded: true }]"/>
                    <error-handler>
                        <on-error-continue logException="true">
                            <logger level="ERROR"
                                    message="#['Cache read failed: '
                                              ++ (error.description default '-')]"/>
                            <set-variable variableName="selected"
                                          value="#[{ points: [], degraded: true }]"/>
                        </on-error-continue>
                    </error-handler>
                </try>
            </otherwise>
        </choice>

        <choice>
            <when expression="#[isEmpty(vars.selected.points)]">
                <raise-error type="ENERGY:UPSTREAM_UNAVAILABLE"
                             description="No upstream responded and the cache held nothing for this period."/>
            </when>
        </choice>

        <set-variable variableName="series" value="#[%dw 2.0
            import seriesSummary from modules::PriceLogic
            output application/java
            ---
            do {
              var s = seriesSummary(vars.selected.points)
              ---
              {
                biddingZone: vars.biddingZone,
                retrievedAt: now() >> 'UTC',
                degraded: vars.selected.degraded,
                resolutionMinutes: s.resolutionMinutes,
                source: s.sources[0],
                points: vars.selected.points
              }
            }]"/>

        <logger level="INFO"
                message="#['Series selected source=' ++ (vars.series.source as String)
                          ++ ' resolution=' ++ (vars.series.resolutionMinutes as String)
                          ++ ' points=' ++ sizeOf(vars.series.points)
                          ++ ' degraded=' ++ (vars.series.degraded as String)]"/>
    </sub-flow>

    <!-- ============================================================
         Upstream calls
         ============================================================ -->

    <sub-flow name="fetch-entsoe">
        <http:request config-ref="entsoe-sys-api"
                      method="GET"
                      path="/api/sys/entsoe/v1/day-ahead-prices"
                      responseTimeout="${upstream.timeoutMs}">
            <http:headers><![CDATA[#[{
                'X-Correlation-Id': correlationId
            }]]]></http:headers>
            <http:query-params><![CDATA[#[{
                biddingZone: vars.biddingZone,
                periodStart: vars.periodStart as String,
                periodEnd: vars.periodEnd as String
            }]]]></http:query-params>
        </http:request>
    </sub-flow>

    <sub-flow name="fetch-awattar">
        <http:request config-ref="awattar-sys-api"
                      method="GET"
                      path="/api/sys/awattar/v1/marketdata"
                      responseTimeout="${upstream.timeoutMs}">
            <http:headers><![CDATA[#[{
                'X-Correlation-Id': correlationId
            }]]]></http:headers>
            <http:query-params><![CDATA[#[{
                from: vars.periodStart as String,
                to: vars.periodEnd as String
            }]]]></http:query-params>
        </http:request>
    </sub-flow>

    <!-- ============================================================
         Persistence: the historical record AND the degraded cache
         ============================================================ -->

    <sub-flow name="persist-series">
        <!--
          One bulk statement rather than a loop. CE has no batch scope,
          but db:bulk-insert takes the whole array and sends a single
          JDBC batch - 96 quarter-hours in one round trip.

          ON CONFLICT makes this idempotent: re-polling the same day is
          harmless, and a revised price updates in place. The BEFORE
          UPDATE trigger on price_point writes the audit row when a value
          actually changes, so no application code has to remember to.

          Timestamps are cast explicitly. The canonical model carries them
          as ISO strings and Postgres will not silently coerce text to
          timestamptz through JDBC.
        -->
        <!--
          ELEMENT ORDER MATTERS: db:bulk-input-parameters must come
          BEFORE db:sql. After db:sql the schema allows only
          db:parameter-types, which is what the error
          "One of {...parameter-types} is expected" is really saying.
          It is not valid as an attribute either.
        -->
        <db:bulk-insert config-ref="priceStore">
            <db:bulk-input-parameters><![CDATA[#[%dw 2.0
                output application/java
                /*
                 * The Postgres JDBC driver infers a parameter's type from
                 * the CAST target and then parses the string itself. It
                 * rejects ISO-8601 with T and Z:
                 *   "Bad value for type timestamp/date/time: 2026-09-24T22:00:00Z"
                 * so values go out as 'yyyy-MM-dd HH:mm:ss' in UTC and the
                 * SQL attaches the zone with AT TIME ZONE 'UTC'.
                 */
                fun pgTimestamp(d) =
                    ((d as DateTime) >> 'UTC') as String {format: "yyyy-MM-dd HH:mm:ss"}
                ---
                vars.toPersist map {
                    zone:       vars.biddingZone,
                    startsAt:   pgTimestamp($.startsAt),
                    endsAt:     pgTimestamp($.endsAt),
                    resolution: $.resolutionMinutes,
                    source:     $.source,
                    perMwh:     $.pricePerMWh,
                    perKwh:     $.pricePerKWh,
                    currency:   ($.currency default 'EUR')
                }]]]></db:bulk-input-parameters>
            <db:sql><![CDATA[
                INSERT INTO price_point (
                    bidding_zone, starts_at, ends_at, resolution_minutes,
                    source, price_per_mwh, price_per_kwh, currency)
                VALUES (
                    :zone,
                    CAST(:startsAt AS timestamp) AT TIME ZONE 'UTC',
                    CAST(:endsAt   AS timestamp) AT TIME ZONE 'UTC',
                    :resolution, :source, :perMwh, :perKwh, :currency)
                ON CONFLICT (bidding_zone, starts_at, source)
                DO UPDATE SET
                    ends_at            = EXCLUDED.ends_at,
                    resolution_minutes = EXCLUDED.resolution_minutes,
                    price_per_mwh      = EXCLUDED.price_per_mwh,
                    price_per_kwh      = EXCLUDED.price_per_kwh
            ]]></db:sql>
        </db:bulk-insert>

        <logger level="INFO"
                message="#['Persisted ' ++ (sizeOf(vars.toPersist) as String)
                          ++ ' points zone=' ++ vars.biddingZone]"/>
    </sub-flow>

    <sub-flow name="read-cached-series">
        <!--
          One query for the whole window, then the same source-preference
          rule the live path uses: finest resolution wins, which in
          practice means ENTSO-E over aWATTar. Resolutions are never
          mixed, here or anywhere else.
        -->
        <db:select config-ref="priceStore">
            <db:sql><![CDATA[
                SELECT starts_at, ends_at, resolution_minutes,
                       source, price_per_mwh, price_per_kwh, currency
                FROM price_point
                WHERE bidding_zone = :zone
                  AND starts_at >= CAST(:periodStart AS timestamp) AT TIME ZONE 'UTC'
                  AND starts_at <  CAST(:periodEnd   AS timestamp) AT TIME ZONE 'UTC'
                ORDER BY starts_at
            ]]></db:sql>
            <db:input-parameters><![CDATA[#[%dw 2.0
                output application/java
                fun pgTimestamp(d) =
                    ((d as DateTime) >> 'UTC') as String {format: "yyyy-MM-dd HH:mm:ss"}
                ---
                {
                    zone: vars.biddingZone,
                    periodStart: pgTimestamp(vars.periodStart),
                    periodEnd: pgTimestamp(vars.periodEnd)
                }]]]></db:input-parameters>
        </db:select>

        <!--
          NOTE: no // comments inside this expression. XML normalises
          newlines in an ATTRIBUTE value to spaces, so a multi-line
          DataWeave script written in value="..." collapses to one line
          and a // comment swallows everything after it - including the
          closing brace. The failure reads "Unexpected end of input,
          expected '}' ... (line 1, column 906)".

          Points read from the store are labelled source: 'CACHE', never
          their original upstream: a consumer has to be able to tell
          stored data from live.
        -->
        <set-payload value="#[%dw 2.0
            output application/java
            var rows = payload default []
            var bySource = rows groupBy ((r) -> r.source)
            var preferred =
                if (!isEmpty(bySource['ENTSOE'] default [])) 'ENTSOE'
                else if (!isEmpty(bySource['AWATTAR'] default [])) 'AWATTAR'
                else null
            ---
            if (preferred == null) []
            else (bySource[preferred] map {
                startsAt: $.starts_at,
                endsAt: $.ends_at,
                resolutionMinutes: $.resolution_minutes,
                pricePerMWh: $.price_per_mwh,
                pricePerKWh: $.price_per_kwh,
                currency: $.currency default 'EUR',
                source: 'CACHE'
            })]"/>

        <logger level="INFO"
                message="#['Cache returned ' ++ sizeOf(payload)
                          ++ ' points zone=' ++ vars.biddingZone]"/>
    </sub-flow>

    <!-- ============================================================
         One error shape, whatever went wrong
         ============================================================ -->

    <sub-flow name="build-api-error">
        <logger level="WARN"
                message="#['Returning ' ++ (vars.httpStatus default 500)
                          ++ ' corr=' ++ (correlationId default '-')
                          ++ ' type=' ++ (error.errorType.identifier default 'UNKNOWN')
                          ++ ' msg=' ++ (error.description default '-')]"/>

        <set-payload value="#[%dw 2.0
            output application/json
            ---
            {
              code: (error.errorType.identifier default 'INTERNAL_ERROR'),
              message: (error.description default 'Unexpected failure.'),
              correlationId: (correlationId default ''),
              occurredAt: now() >> 'UTC'
            }]"/>
    </sub-flow>

</mule>

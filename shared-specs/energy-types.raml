#%RAML 1.0 Library

usage: |
  Canonical energy domain model. Every layer speaks these types.

  SINGLE SOURCE OF TRUTH - this file lives at the repo root in
  shared-specs/ and is copied into each module's
  src/main/resources/api/library/ at build time by the
  maven-resources-plugin. Those copies are gitignored. Edit this file,
  never a copy, or the change will be silently overwritten on the next
  build.

types:

  BiddingZone:
    type: string
    enum: [DE_LU, AT, FR, NL, DK_1, DK_2]
    description: |
      Market bidding zone, normalised to an underscore form. Each maps
      to an ENTSO-E EIC code in the system API - DE_LU is
      10Y1001A1001A82H - but that code never leaves the system layer.
    example: DE_LU

  PricePoint:
    type: object
    description: One settlement interval of day-ahead wholesale price.
    properties:
      startsAt:
        type: datetime
        description: Interval start, always UTC.
      endsAt: datetime
      resolutionMinutes:
        type: integer
        enum: [15, 30, 60]
        description: |
          Read from the upstream, never assumed. ENTSO-E publishes
          quarter-hourly for DE-LU; aWATTar publishes hourly.
      pricePerMWh:
        type: number
        description: Wholesale price as published. Can be negative.
      pricePerKWh:
        type: number
        description: pricePerMWh / 1000, rounded to 5 decimals.
      currency:
        type: string
        enum: [EUR]
      source:
        type: string
        enum: [ENTSOE, AWATTAR, CACHE]
        description: |
          Which upstream this point came from. Part of the model on
          purpose: the process layer never interleaves sources, so a
          consumer can always tell which feed - and which resolution -
          it is looking at.
    example:
      startsAt: 2026-09-24T22:00:00Z
      endsAt: 2026-09-24T22:15:00Z
      resolutionMinutes: 15
      pricePerMWh: 196.99
      pricePerKWh: 0.19699
      currency: EUR
      source: ENTSOE

  PriceSeries:
    type: object
    properties:
      biddingZone: BiddingZone
      retrievedAt: datetime
      degraded:
        type: boolean
        description: |
          True when the primary upstream gave nothing and the response
          comes from the fallback. The fallback publishes at a different
          resolution, so this flag and the points' own
          resolutionMinutes together tell the consumer what it has.
      resolutionMinutes:
        type: integer
        description: The resolution of every point in this series.
      source:
        type: string
        enum: [ENTSOE, AWATTAR, CACHE]
      points:
        type: PricePoint[]
        minItems: 0

  CheapestWindow:
    type: object
    description: |
      The contiguous block of intervals with the lowest mean price.
      Computed in intervals, so it works at any resolution.
    properties:
      startsAt: datetime
      endsAt: datetime
      hours:
        type: integer
        description: The requested window length, in hours.
      intervals:
        type: integer
        description: |
          How many settlement intervals that came to - 16 for four hours
          at PT15M, 4 at PT60M.
      resolutionMinutes: integer
      source:
        type: string
        enum: [ENTSOE, AWATTAR, CACHE]
      meanPricePerKWh: number
      savingVsDayMean:
        type: number
        description: Fraction below the day's mean price, 0..1.
    example:
      startsAt: 2026-09-25T11:00:00Z
      endsAt: 2026-09-25T15:00:00Z
      hours: 4
      intervals: 16
      resolutionMinutes: 15
      source: ENTSOE
      meanPricePerKWh: 0.00236
      savingVsDayMean: 0.42

  ApiError:
    type: object
    properties:
      code:
        type: string
        example: UPSTREAM_UNAVAILABLE
      message: string
      correlationId: string
      occurredAt: datetime
    example:
      code: UPSTREAM_UNAVAILABLE
      message: No price source responded.
      correlationId: 9f2c1b7a-4e10-4d0e-8a6f-2c6b0d1e33aa
      occurredAt: 2026-09-25T09:12:44Z

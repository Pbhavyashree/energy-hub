<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <munit:config name="entsoe-api-test-suite.xml"/>

    <!--
      Fixtures are REAL captured responses (DE-LU, delivery day
      2026-09-25), not synthetic. The synthetic versions these replaced
      were wrong about the namespace, the curve type, the resolution and
      the number of TimeSeries - every test below would have passed
      against them while the mapper failed against production.

      Every expected value here was read out of the captured document.
    -->

    <munit:test name="maps-a-quarter-hourly-day-to-96-points">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref"
                                                whereValue="entsoe-upstream"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[readUrl('classpath://samples/entsoe-a44-REAL.xml',
                                         'text/plain')]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="fetch-day-ahead-prices"/>
        </munit:execution>

        <munit:validation>
            <!--
              96, not 192: the document carries two TimeSeries covering
              the same intervals and only sequence 1 is selected. A result
              of 192 means both auctions were flattened together.
            -->
            <munit-tools:assert-that expression="#[sizeOf(payload)]"
                                     is="#[MunitTools::equalTo(96)]"
                                     message="A PT15M day is 96 intervals from one auction."/>

            <munit-tools:assert-that expression="#[payload[0].resolutionMinutes]"
                                     is="#[MunitTools::equalTo(15)]"
                                     message="Resolution must be read from the document, not assumed hourly."/>

            <munit-tools:assert-that expression="#[payload[0].startsAt as String]"
                                     is="#[MunitTools::equalTo('2026-09-24T22:00:00Z')]"
                                     message="Position 1 maps to periodStart; Berlin midnight is 22:00Z in September."/>

            <munit-tools:assert-that expression="#[payload[-1].endsAt as String]"
                                     is="#[MunitTools::equalTo('2026-09-25T22:00:00Z')]"
                                     message="The series must end exactly at periodEnd."/>
        </munit:validation>
    </munit:test>

    <munit:test name="selects-the-epex-auction-not-exaa"
                description="Two TimeSeries cover the same intervals; sequence 1 is the day-ahead price.">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref"
                                                whereValue="entsoe-upstream"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[readUrl('classpath://samples/entsoe-a44-REAL.xml',
                                         'text/plain')]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="fetch-day-ahead-prices"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[payload[0].pricePerMWh]"
                                     is="#[MunitTools::equalTo(196.99)]"
                                     message="Sequence 1 (EPEX) opens at 196.99."/>

            <!--
              Sequence 2 (EXAA) opens at 192.55. It appears FIRST in the
              document, so taking TimeSeries[0] would silently pick the
              wrong auction - this asserts we did not.
            -->
            <munit-tools:assert-that expression="#[payload[0].pricePerMWh]"
                                     is="#[MunitTools::not(MunitTools::equalTo(192.55))]"
                                     message="192.55 is the EXAA opening price - wrong auction selected."/>
        </munit:validation>
    </munit:test>

    <munit:test name="agrees-with-an-independent-publisher-of-the-same-auction"
                description="Cross-source validation, encoded as a test.">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref"
                                                whereValue="entsoe-upstream"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[readUrl('classpath://samples/entsoe-a44-REAL.xml',
                                         'text/plain')]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="fetch-day-ahead-prices"/>
        </munit:execution>

        <munit:validation>
            <!--
              aWATTar publishes the same EPEX day-ahead auction, hourly.
              For 2026-09-25 it reports 181.94 for hour 00:00-01:00 Berlin.
              The mean of this mapper's first four quarter-hours must equal
              that. If it does not, either the wrong auction was selected
              or the position arithmetic is off - and no amount of
              structural assertion would catch either.
            -->
            <munit-tools:assert-that
                expression="#[%dw 2.0 output application/java --- round((((payload[0 to 3] map $.pricePerMWh) reduce ($$ + $)) / 4) * 10000) / 10000]"
                is="#[MunitTools::equalTo(181.9425)]"
                message="Hourly mean must match aWATTar's published price for the same hour."/>
        </munit:validation>
    </munit:test>

    <munit:test name="holds-prices-forward-across-omitted-positions"
                description="curveType A03 omits repeated values.">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref"
                                                whereValue="entsoe-upstream"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[readUrl('classpath://samples/entsoe-a44-REAL.xml',
                                         'text/plain')]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="fetch-day-ahead-prices"/>
        </munit:execution>

        <munit:validation>
            <!--
              Every interval must carry a price. Mapping declared points
              one-to-one would leave gaps, or produce fewer than 96
              entries, on a document that omits repeated values.
            -->
            <munit-tools:assert-that
                expression="#[%dw 2.0 output application/java --- sizeOf(payload filter ((p) -> p.pricePerMWh == null))]"
                is="#[MunitTools::equalTo(0)]"
                message="No interval may be left without a price."/>

            <munit-tools:assert-that
                expression="#[%dw 2.0 output application/java --- sizeOf(payload filter ((p) -> p.pricePerKWh != round((p.pricePerMWh / 1000) * 100000) / 100000))]"
                is="#[MunitTools::equalTo(0)]"
                message="Every per-kWh price must equal per-MWh / 1000."/>
        </munit:validation>
    </munit:test>

    <munit:test name="intervals-are-contiguous-and-chronological"
                description="Catches an off-by-one in the position arithmetic.">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref"
                                                whereValue="entsoe-upstream"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[readUrl('classpath://samples/entsoe-a44-REAL.xml',
                                         'text/plain')]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="fetch-day-ahead-prices"/>
        </munit:execution>

        <munit:validation>
            <!--
              Each interval's end must be the next one's start. A gap or
              overlap means the resolution or the position arithmetic is
              wrong somewhere in the middle of the day, which the
              first-and-last assertions above would not notice.
            -->
            <munit-tools:assert-that
                expression="#[%dw 2.0 output application/java --- sizeOf((1 to 95) filter ((i) -> (payload[i].startsAt as String) != (payload[i - 1].endsAt as String)))]"
                is="#[MunitTools::equalTo(0)]"
                message="Intervals must be contiguous with no gaps or overlaps."/>
        </munit:validation>
    </munit:test>

    <munit:test name="an-acknowledgement-raises-no-data-not-a-success"
                description="ENTSO-E returns 200 with an Acknowledgement when nothing is published."
                expectedErrorType="ENTSOE:NO_DATA">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref"
                                                whereValue="entsoe-upstream"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[readUrl('classpath://samples/entsoe-a44-acknowledgement-REAL.xml',
                                         'text/plain')]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="fetch-day-ahead-prices"/>
        </munit:execution>
    </munit:test>

</mule>

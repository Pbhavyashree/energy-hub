#%RAML 1.0 Library

usage: Canonical energy domain model, shared by every layer.

types:

  BiddingZone:
    type: string
    enum: [DE_LU, AT, FR, NL, DK_1, DK_2]
    example: DE_LU

  PricePoint:
    type: object
    properties:
      startsAt: datetime
      endsAt: datetime
      resolutionMinutes:
        type: integer
        enum: [15, 30, 60]
      pricePerMWh: number
      pricePerKWh: number
      currency:
        type: string
        enum: [EUR]
      source:
        type: string
        enum: [ENTSOE, AWATTAR, CACHE]
    example:
      startsAt: 2026-09-17T22:00:00Z
      endsAt: 2026-09-17T23:00:00Z
      resolutionMinutes: 60
      pricePerMWh: 139.24
      pricePerKWh: 0.13924
      currency: EUR
      source: AWATTAR

  PriceSeries:
    type: object
    properties:
      biddingZone: BiddingZone
      retrievedAt: datetime
      degraded: boolean
      points: PricePoint[]

  ApiError:
    type: object
    properties:
      code: string
      message: string
      correlationId: string
      occurredAt: datetime
    example:
      code: UPSTREAM_UNAVAILABLE
      message: No price source responded.
      correlationId: 9f2c1b7a-4e10-4d0e-8a6f-2c6b0d1e33aa
      occurredAt: 2026-09-18T09:12:44Z

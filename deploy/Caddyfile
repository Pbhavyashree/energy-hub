# energy-hub, as served.
#
# Caddy terminates TLS (certificate from Let's Encrypt, automatic) and is the
# only way in. The Mule applications publish no ports of their own.
#
# Route order matters: `handle` blocks are mutually exclusive and evaluated
# top to bottom, so the API paths win and everything else falls through to
# the static front end.

{$DOMAIN} {

	encode zstd gzip

	# Experience layer - the household view the front end calls.
	handle /api/exp/* {
		reverse_proxy energy-hub:8093
	}

	# Process layer - orchestration and /health.
	handle /api/prc/* {
		reverse_proxy energy-hub:8090
	}

	# Everything else: the front end.
	handle {
		root * /srv
		file_server
	}

	# The page loads nothing from outside - no CDN, no webfont, no analytics -
	# so the policy can say exactly that. 'unsafe-inline' is required because
	# the stylesheet and script are inline in the single file; everything
	# external is still refused.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'"
	}
}

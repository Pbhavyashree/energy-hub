# Copy to deploy/.env and fill in. deploy/.env is gitignored and must
# never be committed.
#
#   cp deploy/.env.example deploy/.env

# ENTSO-E Transparency Platform security token.
# Account Settings on transparency.entsoe.eu.
ENTSOE_TOKEN=

# Password for the containerised Postgres. Generate one, do not reuse the
# local development password:
#   openssl rand -base64 24
DB_PASSWORD=

# JVM sizing. Defaults suit a 24GB Ampere instance. On a smaller host,
# drop the heap first - metaspace is the one that actually ran out when
# four applications share a runtime.
MULE_HEAP=2048
MULE_METASPACE=768

# Domain Caddy serves on, and requests a Let's Encrypt certificate for.
# A DuckDNS subdomain is fine and free: energy-hub.duckdns.org
# It must already resolve to this server's public IP before the first
# start, or the ACME challenge fails and no certificate is issued.
DOMAIN=

# Negative-price alerting. With ALERT_NEGATIVE_ENABLED=false the flow
# never fires and these can stay empty.
#   Token from @BotFather, chat id from /getUpdates.
ALERT_NEGATIVE_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

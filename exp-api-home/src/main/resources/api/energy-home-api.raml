#%RAML 1.0
title: Home Energy API
version: v1
description: |
  Day-ahead electricity prices shaped for one household app.

  This layer makes the judgements the process layer deliberately refuses
  to make, and hides the ones a household does not care about.

  WHAT IT DECIDES. "Cheap" is not a price, it is a position in today's
  own distribution: the cheapest third of today's intervals is CHEAP, the
  dearest third EXPENSIVE. A fixed threshold would be wrong by the second
  week, and a percentage of the day's mean breaks outright on days with
  negative prices - which German day-ahead has regularly.

  WHAT IT HIDES. Bidding zone is configuration, not a parameter: a
  household is in one zone and should not have to know the term. Prices
  are cents per kWh, because that is the unit on a German electricity
  bill, not EUR/MWh. Times are Berlin wall-clock, because "14:15" is
  actionable and "12:15Z" is not. Settlement resolution, auction
  sequences, and which upstream answered are all absent.

  WHAT IT DOES NOT HIDE. When the data came from the fallback source, the
  response says `estimated: true`. Simplifying is this layer's job;
  overstating confidence is not.

baseUri: http://{host}:{port}/api/exp/home/{version}
baseUriParameters:
  host:
    default: localhost
  port:
    default: "8093"
mediaType: application/json

types:

  Band:
    type: string
    enum: [CHEAP, NORMAL, EXPENSIVE]
    description: |
      Where this interval sits in today's own spread of prices, by
      terciles. Relative on purpose - see the API description.

  Slot:
    type: object
    description: One interval of the day, in local time.
    properties:
      from:
        type: string
        description: Berlin wall-clock start, HH:mm.
      to: string
      cents:
        type: number
        description: Cents per kWh, two decimals. Can be negative.
      band: Band
    example:
      from: "13:15"
      to: "13:30"
      cents: 4.21
      band: CHEAP

  NowView:
    type: object
    properties:
      at:
        type: string
        description: Local time this answer is about, HH:mm.
      cents: number
      band: Band
      verdict:
        type: string
        description: One plain sentence a person can act on.
      estimated: boolean
    example:
      at: "22:15"
      cents: 9.84
      band: NORMAL
      verdict: Nothing special either way.
      estimated: false

  BestTime:
    type: object
    description: When to run something for a given number of hours.
    properties:
      day:
        type: string
        enum: [today, tomorrow]
        description: |
          Which delivery day the window falls in. Clock times alone are
          ambiguous - "03:00" asked at eleven at night could be four
          hours away or twenty-eight.
      from: string
      to: string
      hours: integer
      averageCents: number
      savingPercent:
        type: integer
        description: How far below the day's average this window is.
      estimated: boolean
    example:
      day: today
      from: "13:15"
      to: "15:15"
      hours: 2
      averageCents: 4.76
      savingPercent: 31
      estimated: false

  TodayView:
    type: object
    properties:
      day:
        type: string
        description: Delivery day, local, yyyy-MM-dd.
      averageCents: number
      estimated: boolean
      now:
        type: NowView
        required: false
      bestTime:
        type: BestTime
        required: false
      slots: Slot[]

  Problem:
    type: object
    properties:
      error: string
      message:
        type: string
        description: Written for a person, not for a log.
    example:
      error: PRICES_UNAVAILABLE
      message: Prices are not available right now. Please try again shortly.

/now:
  get:
    displayName: Is now a good time
    description: |
      The interval covering the current instant, banded against the rest
      of today. Small on purpose - this is what a widget or a voice
      assistant asks for.
    responses:
      200:
        body: NowView
      404:
        description: No published interval covers the current instant.
        body: Problem
      503:
        description: Prices could not be retrieved.
        body: Problem

/today:
  get:
    displayName: The whole day
    description: |
      Everything a dashboard needs in one call: every interval in local
      time with its band, the current interval, and the best window to
      run something.
    responses:
      200:
        body: TodayView
      503:
        body: Problem

/best-time:
  get:
    displayName: When to run an appliance
    queryParameters:
      hours:
        type: integer
        required: false
        minimum: 1
        maximum: 12
        description: How long the appliance needs. Defaults to 2.
    responses:
      200:
        body: BestTime
      404:
        description: |
          No window that long is published for today or tomorrow.
        body: Problem
      503:
        body: Problem
